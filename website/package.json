        "lint": "npx eslint .",
        "lint:fix": "npx eslint . --fix"
    },
    "dependencies": {
        "@docusaurus/core": "^3.9.2",
        "@docusaurus/plugin-sitemap": "^3.9.2",
        "@docusaurus/preset-classic": "^3.9.2",
        "@icons-pack/react-simple-icons": "^12.9.0",
